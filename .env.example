# TalentXcel.net Environment Variables
# Copy this file to .env.local and fill in the actual values
# NEVER commit .env.local to version control

# ============================================================
# SUPABASE (Required)
# ============================================================
# Get from: https://supabase.com/dashboard/project/wvuvriewskvvievacida/settings/api

# Public/Anonymous key - safe to expose in browser code
NEXT_PUBLIC_SUPABASE_URL=https://wvuvriewskvvievacida.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service role key - NEVER expose in browser or commit to git
# Used only in server-side code and edge functions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL=https://talentxcel.net
NEXT_PUBLIC_ACADEMY_URL=https://academy.talentxcel.net
NEXT_PUBLIC_AI_URL=https://ai.talentxcel.net
NEXT_PUBLIC_APP_NAME=TalentXcel Academy
NEXT_PUBLIC_APP_ENV=development

# ============================================================
# AI PROVIDERS (Server-side only - never expose in browser)
# ============================================================
# Primary AI provider (openai | google | anthropic)
AI_PRIMARY_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (alternative)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AI Usage limits (tokens per day per user, 0 = unlimited)
AI_DAILY_TOKEN_LIMIT=50000
AI_MAX_CONTEXT_TOKENS=16000

# ============================================================
# PAYMENT PROVIDER (Razorpay - server-side only)
# ============================================================
# SANDBOX mode initially - set to 'live' only when authorized
PAYMENT_MODE=sandbox

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# Public key (safe to expose - used for client-side Razorpay init)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# ============================================================
# EMAIL (Server-side only)
# ============================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM_ADDRESS=noreply@talentxcel.net
EMAIL_FROM_NAME=TalentXcel Academy

# ============================================================
# ANALYTICS (Optional)
# ============================================================
# Privacy-conscious analytics (e.g., Plausible, PostHog)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_HOST=

# ============================================================
# SECURITY
# ============================================================
# Secret for signing internal tokens (generate with: openssl rand -base64 32)
INTERNAL_SECRET=your-strong-random-secret-here

# ============================================================
# FEATURE FLAGS
# ============================================================
NEXT_PUBLIC_FEATURE_AI_TUTOR=false
NEXT_PUBLIC_FEATURE_PAYMENTS=false
NEXT_PUBLIC_FEATURE_OFFLINE=false
NEXT_PUBLIC_FEATURE_ADMISSIONS=true
